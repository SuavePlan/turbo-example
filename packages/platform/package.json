{
  "name": "@repo/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "guarded-build": "./src/guarded-build.ts",
    "platform-info": "./src/platform-info.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "lint": "biome check src",
    "format": "biome format --write src",
    "platform:info": "bun run src/platform-info.ts"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.2"
  }
}
