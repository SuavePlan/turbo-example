{
  "name": "@repo/extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "prepare": "wxt prepare",
    "build": "wxt build && wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox",
    "check": "wxt prepare && tsc --noEmit",
    "test": "bun test",
    "lint": "biome check entrypoints",
    "format": "biome format --write entrypoints"
  },
  "dependencies": {
    "@repo/client": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/ui": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@tailwindcss/vite": "^4.0.0",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "^1.1.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.2",
    "wxt": "^0.19.13"
  }
}
