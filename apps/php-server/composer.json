{
    "name": "suaveplan/turbo-php-server",
    "description": "PHP server in the Turbo polyglot showcase",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "fmt": "pint"
    },
    "config": {
        "sort-packages": true
    }
}
