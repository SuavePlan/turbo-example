{
  "name": "@repo/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "build": "tsc -p tsconfig.json --noEmit",
    "check": "tsc -p tsconfig.json --noEmit",
    "export": "expo export --platform all",
    "test": "bun test src",
    "lint": "biome check src App.tsx index.ts",
    "format": "biome format --write src App.tsx index.ts",
    "build:android": "guarded-build --name mobile:android --requires android-sdk -- expo run:android --no-install",
    "build:ios": "guarded-build --name mobile:ios --requires macos -- expo run:ios --no-install"
  },
  "dependencies": {
    "@repo/client": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/i18n": "workspace:*",
    "expo": "^52.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.5"
  },
  "devDependencies": {
    "@repo/platform": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@types/bun": "latest",
    "@types/react": "~18.3.12",
    "typescript": "^5.9.2"
  }
}
