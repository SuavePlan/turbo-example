{
  "name": "@repo/desktop-electron",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "lint": "biome check src",
    "format": "biome format --write src",
    "package": "bun run package:linux && bun run package:win && bun run package:mac",
    "package:linux": "guarded-build --name desktop-electron:linux --requires linux -- electron-builder --linux --publish never",
    "package:win": "guarded-build --name desktop-electron:win --requires wine -- electron-builder --win --publish never",
    "package:mac": "guarded-build --name desktop-electron:mac --requires macos -- electron-builder --mac --publish never"
  },
  "dependencies": {
    "@repo/client": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/ui": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@repo/platform": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@tailwindcss/vite": "^4.0.0",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.2",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "sh.suaveplan.turbo.electron",
    "productName": "Turbo Showcase (Electron)",
    "directories": { "output": "release" },
    "files": ["dist/**", "electron/**"],
    "linux": { "target": ["AppImage"], "category": "Utility" },
    "win": { "target": ["nsis"] },
    "mac": { "target": ["dmg"] }
  }
}
